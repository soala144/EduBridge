generator client {
  provider = "prisma-client-js"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────────────
// Enums
// ──────────────────────────────────────────────

enum Role {
  STUDENT
  COURSE_REP
  LECTURER
  ADMIN
}

enum SubmissionStatus {
  PENDING
  SUBMITTED
  LATE
  GRADED
}

// ──────────────────────────────────────────────
// Core Entities
// ──────────────────────────────────────────────

model University {
  id         String      @id @default(uuid())
  name       String      @unique
  shortCode  String?     @unique // e.g. UNIPORT
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  faculties  Faculty[]
  users      User[]
}

model Faculty {
  id           String      @id @default(uuid())
  name         String
  shortCode    String?
  universityId String
  university   University  @relation(fields: [universityId], references: [id], onDelete: Cascade)

  departments  Department[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([name, universityId])
}

model Department {
  id         String      @id @default(uuid())
  name       String
  shortCode  String?
  facultyId  String
  faculty    Faculty     @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  courses    Course[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([name, facultyId])
}

model Course {
  id           String        @id @default(uuid())
  code         String        @unique // e.g. CSC 101, GST 112
  title        String
  description  String?
  creditUnits  Int?
  level        String?       // 100, 200, etc.
  semester     String?       // First, Second, Harmattan, Rain
  departmentId String?
  department   Department?   @relation(fields: [departmentId], references: [id])

  lecturers    User[]        @relation("CourseLecturers")
  students     User[]        @relation("CourseStudents")
  reps         User[]        @relation("CourseReps")

  attendances  Attendance[]
  alerts       Alert[]
  resources    Resource[]
  feedbacks    Feedback[]
  assignments  Assignment[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([code])
}

// ──────────────────────────────────────────────
// Users & Roles
// ──────────────────────────────────────────────

model User {
  id              String      @id @default(uuid())
  email           String      @unique
  passwordHash    String?     // only if using credentials
  firstName       String?
  lastName        String?
  matricNumber    String?     @unique // for students
  phone           String?
  role            Role        @default(STUDENT)
  profilePicture  String?     // URL
  isActive        Boolean     @default(true)
  lastLogin       DateTime?

  universityId    String?
  university      University? @relation(fields: [universityId], references: [id])

  // Many-to-many course relations
  coursesAsStudent    Course[]  @relation("CourseStudents")
  coursesAsLecturer   Course[]  @relation("CourseLecturers")
  coursesAsRep        Course[]  @relation("CourseReps")

  attendances         Attendance[]
  submissions         Submission[]
  feedbacks           Feedback[]
  createdAlerts       Alert[]   @relation("CreatedBy")
  markedAttendances   Attendance[] @relation("MarkedBy")
  uploadedResources   Resource[]
  createdAssignments  Assignment[]

  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
}

// ──────────────────────────────────────────────
// Features
// ──────────────────────────────────────────────

model Attendance {
  id          String      @id @default(uuid())
  courseId    String
  userId      String      // the student
  sessionDate DateTime    // e.g. lecture date
  present     Boolean     @default(false)
  markedById  String?     // lecturer or rep who marked
  markedAt    DateTime?

  course      Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  markedBy    User?       @relation("MarkedBy", fields: [markedById], references: [id])

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([courseId, userId, sessionDate]) // one record per student per session
}

model Alert {
  id          String      @id @default(uuid())
  courseId    String
  createdById String
  title       String?
  message     String
  priority    String?     // LOW, MEDIUM, HIGH
  sentAt      DateTime    @default(now())

  course      Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdBy   User        @relation("CreatedBy", fields: [createdById], references: [id])

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Resource {
  id          String      @id @default(uuid())
  courseId    String
  uploadedById String?
  title       String
  description String?
  fileUrl     String      // cloud storage URL (Supabase / S3 / Uploadthing)
  fileType    String?     // pdf, docx, mp4, etc.
  fileSize    Int?        // in bytes
  isPublic    Boolean     @default(true)

  course      Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  uploadedBy  User?       @relation(fields: [uploadedById], references: [id])

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Feedback {
  id          String      @id @default(uuid())
  courseId    String
  userId      String?     // null if anonymous
  rating      Int?        // 1–5
  comment     String?
  anonymous   Boolean     @default(true)
  createdAt   DateTime    @default(now())

  course      Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user        User?       @relation(fields: [userId], references: [id])

  @@index([courseId, createdAt])
}

model Assignment {
  id              String            @id @default(uuid())
  courseId        String
  createdById     String            // usually lecturer
  title           String
  description     String?
  dueDate         DateTime
  maxScore        Int?              @default(100)
  allowLate       Boolean           @default(false)
  attachmentUrl   String?           // question paper / instruction file

  course          Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdBy       User              @relation(fields: [createdById], references: [id])

  submissions     Submission[]

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model Submission {
  id              String            @id @default(uuid())
  assignmentId    String
  studentId       String
  submittedAt     DateTime?
  fileUrl         String?
  textAnswer      String?
  score           Int?
  feedback        String?
  status          SubmissionStatus  @default(PENDING)

  assignment      Assignment        @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student         User              @relation(fields: [studentId], references: [id])

  @@unique([assignmentId, studentId])
}