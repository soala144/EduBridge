generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Attendance {
  id          String   @id @default(uuid())
  courseCode  String
  sessionDate DateTime
  userName    String
  userEmail   String
  matNumber   String?
  present     Boolean  @default(true)
  markedAt    DateTime @default(now())
  sessionKey  String

  @@unique([sessionKey, userEmail])
  @@index([sessionKey])
  @@index([courseCode, sessionDate])
}
